# Lokalne sekrety dla `wrangler dev` (skopiuj do .dev.vars). Na produkcji: `npx wrangler secret put NAZWA`.
ADMIN_PASSWORD=zmien-mnie-lokalnie
# Stripe – lokalnie tylko klucze TESTOWE (sk_test_… / rk_test_…): klucze live pobierają prawdziwe pieniądze.
# Puste = kasa w sklepie pokazuje „Płatności nie są jeszcze włączone”.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Klucz publiczny z wrangler.jsonc jest live – lokalnie nadpisz go testowym pk_test_…
# STRIPE_PUBLISHABLE_KEY=
