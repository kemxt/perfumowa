{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Musi być identyczna z nazwą Workera w panelu Cloudflare (Workers Builds tego wymaga).
  // Konto: Tomex9989@gmail.com's Account; domena perfumowaaura.com jest podpięta w panelu Cloudflare.
  "name": "perfumowa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // SPA: nieznane ścieżki (np. /perfumy/figowy-sad) dostają index.html, routing robi przeglądarka.
    "not_found_handling": "single-page-application",
    // API, zdjęcia wgrane w panelu i webhook Stripe obsługuje kod Workera; reszta to pliki z ./dist (także /admin/).
    "run_worker_first": ["/api/*", "/media/*", "/admin/completed"]
  },
  // Baza produktów (bez database_id – wrangler znajduje ją po nazwie). Schemat: `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perfumowa",
      "migrations_dir": "migrations"
    }
  ],
  // Zdjęcia i pliki wgrane w panelu admina.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "e87801eb02754e4dbe8c97878ef3aca7"
    }
  ],
  // Klucz publiczny Stripe (pk_… jest jawny – trafia do przeglądarki). Zmienne nie przechodzą do env.test,
  // więc wersja testowa bez własnego klucza ma wyłączoną kasę.
  "vars": {
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51UdB4zHX1GoJDbswMNdAjiNEvpe595kQxIeHSNblNQlIj83uUrX8ERwA0czhRf58QsaFfBzIr7AXPUQdPfI2fjSo00WAE6M4zf"
  },
  // Sekrety (poza repo, `npx wrangler secret put NAZWA`, każdy Worker osobno):
  //   ADMIN_PASSWORD         hasło do panelu
  //   STRIPE_SECRET_KEY      klucz API Stripe (sk_… albo ograniczony rk_…)
  //   STRIPE_WEBHOOK_SECRET  sekret webhooka /admin/completed (whsec_…)
  "observability": {
    "enabled": true
  },
  "env": {
    // Wersja testowa: `npx wrangler deploy --env test` → perfumowa-test.tomex9989.workers.dev.
    // Ta sama baza i te same zdjęcia co produkcja, bez domeny perfumowaaura.com.
    "test": {
      "name": "perfumowa-test",
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "perfumowa",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "MEDIA",
          "id": "e87801eb02754e4dbe8c97878ef3aca7"
        }
      ]
    }
  }
}
